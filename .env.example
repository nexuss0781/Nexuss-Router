# ==============================================================================
# NAR configuration
# ==============================================================================
# Copy the lines you need into your Vercel project's environment variables.
# Every value below is a placeholder. Never commit a filled-in copy of this file.
#
# The shortest working setup is TWO values: OMNIROUTE_AI_API_KEY and one
# provider credential from the "Model sources" section. Everything else is
# optional and the gateway runs without it.
# ==============================================================================


# ------------------------------------------------------------------------------
# REQUIRED - the key your clients authenticate with
# ------------------------------------------------------------------------------
# Clients send this as `Authorization: Bearer <key>`. It is yours to choose, so
# generate something random and unguessable:
#
#   node -e "console.log('nar_' + require('crypto').randomBytes(32).toString('hex'))"
#
# Multiple keys, for rotation without downtime, as a comma-separated list:
#   OMNIROUTE_AI_API_KEY="<old-key>,<new-key>"
OMNIROUTE_AI_API_KEY=

# ------------------------------------------------------------------------------
# Model sources
# ------------------------------------------------------------------------------
# Add as many as you like. NAR needs at least one to answer anything; it will
# only serve the models you have a credential for. If you add none, /health
# stays ok and requests return 503 model_not_found, which is expected.
#
# Credentials are read from the environment only. The gateway never ships a
# key, so there is nothing to find in the repository.

# A user token, no signup key required.
OMNIROUTE_PUTER_TOKEN=

# Free API keys from the following, each on its own free tier.
OMNIROUTE_GROQ_API_KEY=
OMNIROUTE_NVIDIA_API_KEY=
OMNIROUTE_MISTRAL_API_KEY=
OMNIROUTE_OPENROUTER_API_KEY=
OMNIROUTE_KILO_API_KEY=

# Override a source's endpoint, model list, or token ceiling. Usually you do not
# need these; the defaults are correct. Set a source's *_MODELS to restrict it.
# OMNIROUTE_GROQ_MODELS="llama-3.3-70b-versatile"
# OMNIROUTE_GROQ_BASE_URL="https://api.groq.com/openai/v1"
# OMNIROUTE_GROQ_MIN_MAX_TOKENS="1024:8192"
# OMNIROUTE_PUTER_MODELS="puter:qwen/qwen3.8-27b:free"


# ------------------------------------------------------------------------------
# OPTIONAL - policy, usage accounting, and shared state
# ------------------------------------------------------------------------------
# Without a database the gateway still serves traffic, in memory, per instance.
# Add one and you get API key policies, usage history, and rate limits shared
# across instances instead of reset per instance. Vercel Postgres and Neon both
# supply POSTGRES_URL or DATABASE_URL; Supabase supplies POSTGRES_URL.
#
# Set exactly one of these:
# POSTGRES_URL=
# DATABASE_URL=
# SUPABASE_DB_URL=
# POSTGRES_URL_NON_POOLING=
# SUPABASE_DB_SSL=false

# Needed only if you want per-key policies rather than a single shared key.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=


# ------------------------------------------------------------------------------
# OPTIONAL - long-lived runtime
# ------------------------------------------------------------------------------
# Handles requests that outrun a serverless function's execution window, so long
# generations are not cut off. Unset means no runtime and shorter requests only.
# RENDER_SERVICE_URL=
# RENDER_INTERNAL_SECRET=

# From the configuration above, these are the knobs worth knowing:
# OMNIROUTE_AI_AUTO_MODELS=            # restrict what "auto" may choose
# OMNIROUTE_PROMPT_GUARD=0-100         # reject prompt-guard matches, 0 disables
# OMNIROUTE_CACHE_TTL_MS=              # shared response cache lifetime
# RENDER_FORWARDING_DISABLED=true      # never forward, even if a runtime exists
# RENDER_FORWARD_TIMEOUT_MS=
